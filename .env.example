# Copy to .env.local for development; set the same names in your host's dashboard.

# AI tutor (server-side only). Without it the Tutor tab shows "not connected".
ANTHROPIC_API_KEY=

# Postgres (Supabase). Needed in production so the community directory and
# contributions persist. Without it they live in memory and reset on restart.
# Use the pooled connection string. Apply supabase/migrations then supabase/seed.sql.
DATABASE_URL=

# Local development only. "true" walks past the onboarding gate so the screens
# behind it can be worked on without creating an account. Ignored by `next build`
# (NODE_ENV is "production" there), so it cannot leak into a deployment.
DEV_SKIP_ONBOARDING=

# Local development only. Which language the gated screens render as while
# DEV_SKIP_ONBOARDING is on. Defaults to kiswahili.
DEV_LANGUAGE=

# Free AI tutor. Either key switches the tutor from lookup-only to
# conversational; both are free to obtain and neither needs a card.
#   GEMINI_API_KEY      https://aistudio.google.com/apikey
#   OPENROUTER_API_KEY  https://openrouter.ai/keys  (uses a :free model)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
