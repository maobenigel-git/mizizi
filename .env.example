# Copy to .env.local for development; set the same names in your host's dashboard.

# ── Required in production ──────────────────────────────────────────────────

# Signs the session cookie so streaks, XP and user ids cannot be hand-edited.
# At least 32 random characters: `openssl rand -base64 48`. The app refuses to
# serve signed-in pages in production without it. Changing it signs everyone
# out of this device (account holders sign back in and keep their progress).
SESSION_SECRET=

# Postgres (Supabase or any Postgres 15+ with pgvector). Holds accounts, synced
# progress, lesson notes, the community directory and contributions. Without it
# all of those live in memory and are lost on restart — fine locally, not in
# production. Use the pooled connection string, then apply every file in
# supabase/migrations in order, then supabase/seed.sql.
DATABASE_URL=

# ── Optional: AI tutor ──────────────────────────────────────────────────────
# The tutor always works: with no key it answers from checked data only
# (lookup mode). Any key below upgrades it to conversation; the first one set
# wins, in this order.

# Paid, best quality. Server-side only.
ANTHROPIC_API_KEY=

# Free tiers, no card needed.
#   GEMINI_API_KEY      https://aistudio.google.com/apikey
#   OPENROUTER_API_KEY  https://openrouter.ai/keys  (uses a :free model)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Optional: pronunciation checking ───────────────────────────────────────
# Google Cloud Speech-to-Text V2 (model chirp_2) hears Kiswahili (sw-KE),
# Dholuo (luo-KE) and Kamba (kam-KE) and scores each word. Without these,
# Kiswahili falls back to the browser's recogniser (Chrome/Edge) and other
# languages get unscored read-aloud practice. Called only from the server.
#
# Setup:
#   1. Create a project: https://console.cloud.google.com/ (new accounts get free credits)
#   2. Enable the API: https://console.cloud.google.com/apis/library/speech.googleapis.com
#   3. Create a service account with a role that grants speech.recognizers.recognize,
#      and download a JSON key: https://console.cloud.google.com/iam-admin/serviceaccounts
#   4. Paste the key below — raw JSON on one line, or base64 (`base64 -w0 key.json`).
# Pricing: $0.016 per audio minute, rounded up per second (~$0.0008 per attempt).
GOOGLE_SERVICE_ACCOUNT_KEY=
# Defaults to the project_id in the key.
GOOGLE_CLOUD_PROJECT=
# us-central1 or europe-west4 — the regions where chirp_2 serves these languages.
GOOGLE_SPEECH_REGION=us-central1

# ── Optional: NLLB-200 machine translation ─────────────────────────────────
# Meta's facebook/nllb-200-distilled-600M adds whole-sentence translation into
# Gikuyu and Kamba (and Kiswahili, Dholuo, Somali), tried after Google. Output is
# labelled machine translation. Model licence: CC BY-NC 4.0 (non-commercial).
#
# Hugging Face's serverless Inference API does NOT host this model, so a token
# alone isn't enough — point NLLB_ENDPOINT_URL at something that serves it:
#   - a Hugging Face Inference Endpoint deployed from the model
#     (https://endpoints.huggingface.co), token from https://huggingface.co/settings/tokens
#   - or the MMS server's /translate (mms-server/, with NLLB_MODEL set)
HUGGINGFACE_API_TOKEN=hf_your_token_here
NLLB_ENDPOINT_URL=
# Only when the endpoint uses a different token (e.g. the MMS server's):
NLLB_ENDPOINT_TOKEN=

# ── Optional: self-hosted MMS speech server ─────────────────────────────────
# Base URL of mms-server/ running on a GPU instance (e.g. NVIDIA Brev). Adds
# scored speaking practice and a machine voice for languages Google lacks —
# notably Gikuyu. If the server is stopped or unreachable, the app carries on
# without it. Called only from the server. See mms-server/README.md.
MMS_SERVER_URL=https://your-mms-instance.example.com
# The same shared secret set as MMS_SERVER_TOKEN on the speech server.
MMS_SERVER_TOKEN=

# ── Local development only (ignored by `next build`) ───────────────────────

# Local development only. "true" walks past the onboarding gate so the screens
# behind it can be worked on without creating an account. Ignored by `next build`
# (NODE_ENV is "production" there), so it cannot leak into a deployment.
DEV_SKIP_ONBOARDING=

# Local development only. Which language the gated screens render as while
# DEV_SKIP_ONBOARDING is on. Defaults to kiswahili.
DEV_LANGUAGE=

# Local development only. "true" fills a fresh session with sample progress —
# a 5-day streak ending yesterday, a week of activity, XP and one saved word —
# so the streak, week strip, daily goal and notebook render their real state
# instead of their empty one. Applied only to a session that has done nothing
# yet, so it never overwrites progress you made. Ignored by `next build`.
DEV_MOCK_STREAK=
